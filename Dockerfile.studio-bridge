# Staging identity bridge only; never starts API, worker, migrations or provider adapters.
FROM node:22-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY src ./src
COPY scripts/staging/studio-bridge.js ./scripts/staging/studio-bridge.js
ENV PORT=8080 BG_BRIDGE_BIND=0.0.0.0
USER node
EXPOSE 8080
CMD ["node", "scripts/staging/studio-bridge.js"]
