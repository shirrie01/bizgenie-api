{
  "contract_version": "bizgenie.customer-launch.v1",
  "status": "review_candidate_not_deployed",
  "source_baselines": {
    "api_226": "f1fc2f51502793d9fb03617f30fd72b5a61c1e2e",
    "api_227": "b400d27f7cdd516a772d45873adaa59a70f0c4b8",
    "web_66": "8367d677e6c1f3bb23d4085334fd0601b5e1b45e",
    "web_68": "433c898d9f087e44e00f272db3ad0565d84479f7"
  },
  "authority": "Existing implementation and founder-approved scope; no pricing or access grant is created by this contract",
  "coverage": "Customer launch integration handoff, not a replacement for complete Zod request schemas",
  "authentication": {
    "header": "Authorization: Bearer <customer access token>",
    "verification": "Supabase getClaims with issuer/audience/expiry and trusted scope; never use service-role key as customer identity",
    "identity_only": [
      "GET /customer/workspace",
      "POST /customer/workspace/select",
      "GET /customer/billing/subscription"
    ],
    "scope": "tenant_id/project_id/brand_id selectors are resources, never authority; selected-workspace routes use verified trusted_scope",
    "switch": "Explicit selection then session refresh; client must confirm new claims match selected workspace",
    "privacy": {
      "Cache-Control": "private, no-store",
      "Vary": "Authorization"
    }
  },
  "scope_sets": {
    "project": [
      "tenant_id",
      "project_id"
    ],
    "brand": [
      "tenant_id",
      "project_id",
      "brand_id"
    ]
  },
  "endpoints": [
    {
      "id": "workspaces",
      "method": "GET",
      "path": "/customer/workspace",
      "implementation": "src/customer-workspace/router.js",
      "request": "identity token; no scope body",
      "response_fields": [
        "status",
        "workspace"
      ],
      "response_statuses": [
        "missing_workspace",
        "ready",
        "selection_required"
      ],
      "read_only": true,
      "conditional_response_fields": {
        "selection_required": [
          "workspaces"
        ]
      },
      "optional_response_fields": [
        "workspaces"
      ],
      "response_field_types": {
        "status": "string",
        "workspace": "object|null",
        "workspaces": "array"
      }
    },
    {
      "id": "select_workspace",
      "method": "POST",
      "path": "/customer/workspace/select",
      "implementation": "src/customer-workspace/router.js",
      "request_fields": [
        "tenant_id",
        "project_id",
        "brand_id"
      ],
      "response_fields": [
        "status",
        "workspace",
        "requires_session_refresh"
      ],
      "read_only": false
    },
    {
      "id": "brand_read",
      "method": "GET",
      "path": "/customer/workspace/brand-brain",
      "implementation": "src/customer-workspace/router.js",
      "request": "trusted_scope token",
      "response_fields": [
        "brand_brain"
      ],
      "read_only": true,
      "response_field_types": {
        "brand_brain": "object"
      }
    },
    {
      "id": "brand_save",
      "method": "PUT",
      "path": "/customer/workspace/brand-brain",
      "implementation": "src/customer-workspace/service.js",
      "request": "Full editable Brand Brain document; omitted optional fields removed",
      "owner_only_fields": [
        "name",
        "identity.description"
      ],
      "response_fields": [
        "brand_brain"
      ],
      "errors": {
        "403": [
          "BRAND_BRAIN_WRITE_FORBIDDEN"
        ],
        "409": [
          "BRAND_BRAIN_VERSION_CONFLICT"
        ]
      },
      "read_only": false,
      "response_field_types": {
        "brand_brain": "object"
      }
    },
    {
      "id": "onboarding",
      "method": "GET",
      "path": "/customer/workspace/onboarding",
      "implementation": "src/workspace-onboarding/router.js",
      "response_fields": [
        "status",
        "onboarding",
        "brand_name_placeholder"
      ],
      "dto_contract": "workspace-onboarding.v1",
      "read_only": true,
      "response_field_types": {
        "status": "string",
        "onboarding": "object",
        "brand_name_placeholder": "boolean"
      }
    },
    {
      "id": "onboarding_save",
      "method": "PUT",
      "path": "/customer/workspace/onboarding",
      "implementation": "src/workspace-onboarding/schema.js",
      "request": "Existing version/idempotency/draft/completion Zod schema; scope comes from token, not body",
      "response_fields": [
        "status",
        "replayed",
        "onboarding",
        "brand_name_placeholder"
      ],
      "owner_only": true,
      "read_only": false,
      "request_fields": [
        "idempotency_key",
        "expected_version"
      ],
      "optional_fields": [
        "sector_key",
        "sector_source",
        "industry_text",
        "channels",
        "channels_source",
        "current_step",
        "draft",
        "complete"
      ],
      "completion": "Explicit customer confirmation, customer-written genuine name/description and customer-selected sector/channels; no entitlement/provider authority",
      "response_field_types": {
        "status": "string",
        "replayed": "boolean",
        "onboarding": "object",
        "brand_name_placeholder": "boolean"
      }
    },
    {
      "id": "campaign_create",
      "method": "POST",
      "path": "/customer/campaigns",
      "implementation": "src/campaigns/router.js",
      "request_fields": [
        "tenant_id",
        "project_id",
        "idempotency_key",
        "brand_id",
        "name",
        "goal",
        "display_timezone"
      ],
      "response_fields": [
        "result",
        "campaign"
      ],
      "success_status": 201,
      "read_only": false,
      "response_field_types": {
        "result": "object",
        "campaign": "object"
      }
    },
    {
      "id": "campaign_get",
      "method": "GET",
      "path": "/customer/campaigns/:campaignId",
      "implementation": "src/campaigns/router.js",
      "query_fields": [
        "tenant_id",
        "project_id"
      ],
      "response_fields": [
        "campaign"
      ],
      "read_only": true,
      "response_field_types": {
        "campaign": "object"
      }
    },
    {
      "id": "content_item",
      "method": "POST",
      "path": "/customer/campaigns/:campaignId/content-items",
      "implementation": "src/campaigns/router.js",
      "request_fields": [
        "tenant_id",
        "project_id",
        "idempotency_key",
        "expected_campaign_version",
        "name",
        "format",
        "platform",
        "placement",
        "destination_label"
      ],
      "optional_fields": [
        "destination_key",
        "initial_content"
      ],
      "response_fields": [
        "result",
        "campaign"
      ],
      "success_status": 201,
      "read_only": false,
      "response_field_types": {
        "result": "object",
        "campaign": "object"
      }
    },
    {
      "id": "generation_quote",
      "method": "POST",
      "path": "/customer/generation-quotes",
      "implementation": "src/generation-quotes/service.js",
      "request_fields": [
        "tenant_id",
        "project_id",
        "campaign_id",
        "variant_id",
        "expected_campaign_version",
        "execution_class",
        "idempotency_key"
      ],
      "optional_fields": [
        "execution_mode",
        "execution_brief",
        "supplied_assets",
        "content_dna",
        "strategy_stage"
      ],
      "response_contract": "generation-quote.v1",
      "response_fields": [
        "quote_id",
        "execution_class",
        "credits",
        "kind",
        "max_credits",
        "available_credits",
        "sufficient",
        "expires_at",
        "policy_version",
        "state"
      ],
      "success_status": 201,
      "read_only": false,
      "paid_provider_call": false,
      "rule": "No reservation or provider submission at quote time; persisted quote is a database write",
      "conditional_requirements": {
        "execution_brief": "Required non-empty for image/video execution; omitted image brief returns 422 CREATIVE_BRIEF_REQUIRED"
      },
      "response_field_types": {
        "quote_id": "string",
        "credits": "integer",
        "max_credits": "integer",
        "available_credits": "integer",
        "sufficient": "boolean",
        "expires_at": "string"
      }
    },
    {
      "id": "generation_confirm",
      "method": "POST",
      "path": "/customer/generation-quotes/:quoteId/confirm",
      "implementation": "src/generation-quotes/service.js",
      "request_fields": [
        "idempotency_key",
        "max_credits",
        "confirmed"
      ],
      "constraints": {
        "confirmed": true,
        "max_credits": "must equal quoted credit cost"
      },
      "response_fields": [
        "status",
        "job_id",
        "quote_id",
        "reserved_credits",
        "replay"
      ],
      "success_status": 202,
      "read_only": false,
      "rule": "Atomic reservation and one execution claim; never confirm implicitly",
      "response_field_types": {
        "status": "string",
        "job_id": "string",
        "quote_id": "string",
        "reserved_credits": "integer",
        "replay": "boolean"
      }
    },
    {
      "id": "generation_status",
      "method": "GET",
      "path": "/customer/generation-quotes/:quoteId",
      "implementation": "src/generation-quotes/service.js",
      "response_fields": [
        "quote_id",
        "job_id",
        "state",
        "execution_class",
        "error_code",
        "reserved_credits",
        "reservation_state"
      ],
      "read_only": true
    },
    {
      "id": "generation_cancel",
      "method": "POST",
      "path": "/customer/generation-quotes/:quoteId/cancel",
      "implementation": "src/generation-quotes/service.js",
      "rule": "Owner who owns quote; pre-call cancellation only, releases once; uncertain provider outcome requires reconciliation",
      "read_only": false
    },
    {
      "id": "creative_job",
      "method": "GET",
      "path": "/customer/creative-jobs/:jobId",
      "implementation": "src/generation-quotes/jobs.js",
      "query_scope": "brand",
      "response_contract": "creative-job.v1",
      "response_fields": [
        "job_id",
        "quote_id",
        "kind",
        "execution_class",
        "state",
        "outputs",
        "association",
        "preview",
        "can_cancel",
        "retry_guidance"
      ],
      "read_only": true,
      "response_field_types": {
        "job_id": "string",
        "quote_id": "string",
        "kind": "string",
        "state": "string",
        "outputs": "array",
        "association": "object|null",
        "preview": "object|null",
        "can_cancel": "boolean"
      }
    },
    {
      "id": "creative_attach",
      "method": "POST",
      "path": "/customer/creative-jobs/:jobId/attach",
      "implementation": "src/generation-quotes/jobs.js",
      "request_scope": "brand",
      "response_contract": "creative-job.v1",
      "owner_only": true,
      "rule": "Attach existing succeeded output to original version-bound target; stable idempotency; new successor revision; never silently rebase",
      "read_only": false,
      "response_field_types": {
        "job_id": "string",
        "association": "object",
        "outputs": "array"
      }
    },
    {
      "id": "creative_preview",
      "method": "GET",
      "path": "/customer/campaigns/:campaignId/variants/:variantId/creative-preview",
      "implementation": "src/campaigns/router.js",
      "query_fields": [
        "tenant_id",
        "project_id",
        "revision_id",
        "expected_campaign_version"
      ],
      "response_fields": [
        "preview"
      ],
      "read_only": true
    },
    {
      "id": "media_bytes",
      "method": "GET",
      "path": "/customer/campaigns/:campaignId/variants/:variantId/revisions/:revisionId/assets/:assetId/preview",
      "implementation": "src/media/previewDelivery.js",
      "query_fields": [
        "tenant_id",
        "project_id",
        "expected_campaign_version"
      ],
      "mime_types": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "video/mp4"
      ],
      "rule": "Authenticated private delivery; rights and lineage checked, generation-pinned reads; no public/signed URLs; stale version 409; foreign/revoked asset 404; explicit video ranges bounded",
      "read_only": "conditional: optional runtime delivery budget hook writes counters; inspect deployed composition before no-write probe"
    },
    {
      "id": "calendar",
      "method": "GET",
      "path": "/customer/calendar",
      "implementation": "src/campaigns/workspaceCalendar.js",
      "query_fields": [
        "tenant_id",
        "project_id",
        "from",
        "to"
      ],
      "optional_fields": [
        "cursor",
        "limit",
        "campaign_id",
        "platform",
        "workflow"
      ],
      "response_contract": "workspace-calendar.v1",
      "response_fields": [
        "window",
        "entries",
        "unscheduled",
        "next_cursor"
      ],
      "constraints": {
        "window": "from inclusive/to exclusive; max 93 elapsed days per request",
        "limit": "1..100"
      },
      "read_only": true,
      "response_field_types": {
        "window": "object",
        "entries": "array",
        "unscheduled": "array",
        "next_cursor": "string|null"
      }
    },
    {
      "id": "review",
      "method": "POST",
      "path": "/customer/campaigns/:campaignId/variants/:variantId/review",
      "implementation": "src/campaigns/router.js",
      "read_only": false,
      "request_fields": [
        "tenant_id",
        "project_id",
        "idempotency_key",
        "expected_campaign_version",
        "revision_id"
      ],
      "response_fields": [
        "result",
        "campaign"
      ]
    },
    {
      "id": "preview-renders",
      "method": "POST",
      "path": "/customer/campaigns/:campaignId/variants/:variantId/preview-renders",
