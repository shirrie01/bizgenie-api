      "read_only": false,
      "request_fields": [
        "tenant_id",
        "project_id",
        "idempotency_key",
        "expected_campaign_version",
        "schedule_id"
      ],
      "response_fields": [
        "result",
        "campaign"
      ]
    },
    {
      "id": "connections",
      "method": "GET",
      "path": "/customer/social/connections",
      "implementation": "src/social-publishing/service.js",
      "query_scope": "brand",
      "response_fields": [
        "connections",
        "next_cursor"
      ],
      "connection_fields": [
        "connection_id",
        "platform",
        "account_id",
        "display_name",
        "status",
        "expires_at",
        "version"
      ],
      "optional_connection_fields": [
        "capabilities",
        "granted_scopes"
      ],
      "read_only": true,
      "response_field_types": {
        "connections": "array",
        "next_cursor": "string|null"
      }
    },
    {
      "id": "oauth_intent",
      "method": "POST",
      "path": "/customer/social/oauth-intents",
      "implementation": "src/social-publishing/service.js",
      "request_fields": [
        "tenant_id",
        "project_id",
        "brand_id",
        "platform",
        "pkce_challenge"
      ],
      "response_contract": "social-oauth-intent.v1",
      "response_fields": [
        "intent_id",
        "state",
        "expires_at",
        "authorize_url",
        "redirect_uri",
        "authorization_status"
      ],
      "optional_fields": [
        "oauth_protocol",
        "provider_pkce_required"
      ],
      "read_only": false
    },
    {
      "id": "oauth_callback",
      "method": "GET",
      "path": "/customer/social/oauth/callback/:platform",
      "implementation": "src/social-publishing/router.js",
      "request": "Provider state/code relay only, no bearer; allowlisted platform; state/expiry/config checked",
      "success_status": 303,
      "rule": "Does not complete connection or grant scope; owner+browser verifier completion still required",
      "read_only": true,
      "excluded_from_live_read_only_acceptance": true
    },
    {
      "id": "oauth_complete",
      "method": "POST",
      "path": "/customer/social/oauth-complete",
      "implementation": "src/social-publishing/service.js",
      "request_fields": [
        "tenant_id",
        "project_id",
        "brand_id",
        "intent_id",
        "state",
        "code",
        "code_verifier"
      ],
      "response": "connection object, not an envelope",
      "read_only": false
    },
    {
      "id": "disconnect",
      "method": "POST",
      "path": "/customer/social/connections/:id/disconnect",
      "implementation": "src/social-publishing/service.js",
      "request_scope": "brand",
      "response": "revoked connection plus provider_revocation_status if attempted; LinkedIn local-only",
      "read_only": false
    },
    {
      "id": "dispatch",
      "method": "POST",
      "path": "/customer/social/dispatches",
      "implementation": "src/social-publishing/service.js",
      "request_fields": [
        "tenant_id",
        "project_id",
        "brand_id",
        "campaign_id",
        "variant_id",
        "schedule_id",
        "expected_campaign_version",
        "publishing_confirmed"
      ],
      "optional_fields": [
        "connection_id"
      ],
      "constraints": {
        "publishing_confirmed": true,
        "connection_id": "omitted: resolved server-side from bound destination; never exposed in campaign view"
      },
      "response": "dispatch object",
      "read_only": false
    },
    {
      "id": "credit_read",
      "method": "GET",
      "path": "/customer/billing/subscription",
      "implementation": "src/billing/customerRouter.js",
      "query_fields": [
        "tenant_id"
      ],
      "response_fields": [
        "status",
        "subscription",
        "available_credits"
      ],
      "response_statuses": [
        "ready",
        "not_subscribed"
      ],
      "read_only": true,
      "rule": "Ledger-derived balance, no Stripe network call or write",
      "response_field_types": {
        "status": "string",
        "subscription": "object|null",
        "available_credits": "integer|null"
      }
    },
    {
      "id": "plans",
      "method": "GET",
      "path": "/customer/billing/plans",
      "implementation": "src/billing/customerRouter.js",
      "rule": "Approved catalog only; COMMERCIAL_CATALOG_UNAVAILABLE if absent; never infer prices or allowances",
      "read_only": true,
      "query_fields": [
        "tenant_id"
      ]
    },
    {
      "id": "workspace_bootstrap",
      "method": "POST",
      "path": "/customer/workspace/bootstrap",
      "implementation": "src/customer-workspace/router.js",
      "authentication": "verified customer identity token; trusted scope not yet required",
      "request_fields": [],
      "optional_fields": [
        "business_name",
        "website_or_social_profile",
        "primary_marketing_challenge"
      ],
      "response_fields": [
        "status"
      ],
      "conditional_response_fields": {
        "ready": [
          "workspace"
        ],
        "selection_required": [
          "workspace",
          "workspaces"
        ]
      },
      "optional_response_fields": [
        "requires_session_refresh"
      ],
      "success_status": 201,
      "read_only": false,
      "rule": "Existing provisioning only; subsequent scope refresh required when flagged; no entitlement/provider grant"
    },
    {
      "id": "customer_upload_remove",
      "method": "DELETE",
      "path": "/customer/assets/:assetId",
      "implementation": "src/media-intake/router.js",
      "query_fields": [
        "tenant_id",
        "project_id",
        "brand_id"
      ],
      "response_fields": [
        "asset_id",
        "state",
        "physical_deletion"
      ],
      "owner_only": true,
      "read_only": false,
      "rule": "Logical deletion, idempotent and tenant-bound; bytes remain pending retention policy; browser delete gates stay off until hosted acceptance"
    }
  ],
  "social": {
    "connection_states": [
      "active",
      "expired",
      "revoked"
    ],
    "oauth_web": {
      "linkedin": {
        "protocol": "linkedin_oidc_web",
        "client_parameter": "client_id",
        "provider_pkce_required": false,
        "scopes_requested": [
          "openid",
          "profile",
          "w_member_social"
        ],
        "callback": "https://getbizgenie.com/customer/social/oauth/callback/linkedin"
      },
      "tiktok": {
        "protocol": "tiktok_web_v2",
        "client_parameter": "client_key",
        "provider_pkce_required": false,
        "scopes_requested": [
          "user.info.basic",
          "video.upload"
        ],
        "callback_default": "https://getbizgenie.com/customer/social/oauth/callback/tiktok",
        "reviewed_staging_override": "https://staging-api.getbizgenie.com/customer/social/oauth/callback/tiktok"
