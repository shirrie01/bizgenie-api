      ]
    },
    {
      "id": "reschedule",
      "method": "POST",
      "path": "/customer/campaigns/:campaignId/variants/:variantId/reschedule",
      "implementation": "src/campaigns/router.js",
      "read_only": false,
      "request_fields": [
        "tenant_id",
        "project_id",
        "idempotency_key",
        "expected_campaign_version",
        "revision_id",
        "scheduled_for",
