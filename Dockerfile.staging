# ISOLATED STAGING IMAGE (BG-LAUNCH-003). Not the production image and not used by it.
# The production Dockerfile has no media toolchain, so Veo output validation and upload inspection cannot run there (ffprobe/ffmpeg are required by
# src/media/videoInspection.js and videoDecode.js). This image adds them on the same pinned Node 22 base. Hardened (bubblewrap) isolation needs unprivileged
# user namespaces, which most managed runtimes do not allow, so staging runs the container itself as the sandbox: VIDEO_INSPECTION_ISOLATION=local.
# Moving media validation to production needs a security review of that choice and a pinned toolchain (runtime/video-inspection-toolchain.v1.json).
FROM node:22-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg bubblewrap util-linux \
 && rm -rf /var/lib/apt/lists/* \
 && ffprobe -version | head -1 && ffmpeg -version | head -1 && test -x /usr/bin/prlimit

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY . .

ENV PORT=8080 VIDEO_INSPECTION_ISOLATION=local
EXPOSE 8080
# The API process; run the same image with `node worker.js` for the background worker.
USER node
CMD ["npm", "start"]
