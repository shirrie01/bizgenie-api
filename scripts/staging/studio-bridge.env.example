SUPABASE_PUBLISHABLE_KEY=REUSE_EXISTING_PUBLIC_STAGING_KEY
BG_BRIDGE_TARGET_URL=REPLACE_WITH_VERIFIED_ZERO_TRAFFIC_TAG_URL
BG_BRIDGE_AUDIENCE=REPLACE_WITH_VERIFIED_STAGING_SERVICE_URL
