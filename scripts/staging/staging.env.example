# Isolated staging for the first real image + video demonstration (BG-LAUNCH-003).
# Copy to scripts/staging/staging.env (git-ignored), fill in, then: npm run staging:preflight
# NEVER put production values here. Secrets are checked for presence only and are never printed.
BIZGENIE_ENVIRONMENT=staging

# --- what is switched on for the media demo (everything else stays off) ---
MEDIA_STORAGE_ENABLED=true
IMAGE_GENERATION_ENABLED=true
VIDEO_GENERATION_ENABLED=true
QUOTED_GENERATION_ENABLED=true
TEXT_GENERATION_MODEL=
VIDEO_DURATION_SECONDS=4          # demo cap: one 4 s clip
VIDEO_ASPECT_RATIO=9:16
IMAGE_ASPECT_RATIO=1:1
VIDEO_INSPECTION_ISOLATION=local  # the staging image is the sandbox; see Dockerfile.staging

# --- founder-provided (blank here on purpose) ---
TEST_DATABASE_URL=                # disposable PostgreSQL 17 superuser URL
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLOUD_PROJECT=
MEDIA_STORAGE_BUCKET=
VIDEO_PROVIDER_OUTPUT_STORAGE_URI=gs://BUCKET/veo-out/
GOOGLE_APPLICATION_CREDENTIALS=   # path to a service-account key file, or use workload identity
OPENAI_API_KEY=
STRIPE_SECRET_KEY=                # sk_test_... only
